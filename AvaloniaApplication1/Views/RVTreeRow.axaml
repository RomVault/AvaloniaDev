<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaApplication1.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:DataType="vm:RVTreeRowViewModel"
             x:Class="AvaloniaApplication1.Views.RVTreeRow">

    <UserControl.Styles>
        <!-- Null (Locked) state: replace the Fluent indeterminate dash with a locked padlock. -->
        <Style Selector="CheckBox:indeterminate /template/ Path#CheckGlyph">
            <Setter Property="Data" Value="M2.5,6 V4 A3.5,3.5 0 0 1 9.5,4 V6 H8 V4 A2,2 0 0 0 4,4 V6 Z M1,6 H11 V14 H1 Z"/>
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="11"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="2">
        <CheckBox x:Name="RowCheck" IsChecked="{Binding IsChecked}" IsThreeState="False"
                  PointerPressed="CheckBox_PointerPressed"
                  ContextRequested="CheckBox_ContextRequested"
                  IsEnabled="{Binding $parent[TreeView].((vm:RVTreeViewModel)DataContext).IsIdle}"
                  VerticalAlignment="Top"/>
        <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Top"/>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>

            <ItemsControl ItemsSource="{Binding extraInfo}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </StackPanel>
</UserControl>