<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        xmlns:local="using:AvaloniaApplication1"
        xmlns:views="using:AvaloniaApplication1.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AvaloniaApplication1">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <Window.Styles>




        <!-- Thin the tree rows.
        TreeViewItem itself floors at 32px via the TreeViewItemMinHeight
        resource (its own Padding is already 0). But the real floor turned
        out to be the CheckBox in the row template: Fluent's CheckBox
        template has an inner Grid hardcoded to
        Height="{DynamicResource CheckBoxMinHeight}" (also 32) - a resource
        binding, not a TemplateBinding, so setting CheckBox.MinHeight/
        Padding directly (tried first) has no effect. Overriding
        CheckBoxMinHeight down in TreeView.Resources below is what actually
        shrinks it, scoped to just this tree's checkboxes. -->
        <Style Selector="TreeViewItem">
            <Setter Property="MinHeight" Value="10"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>


    </Window.Styles>


    <DockPanel>
        <views:TopMenu DockPanel.Dock="Top"/>


        <Grid
            ColumnDefinitions="100,400,10,*"
            RowDefinitions="160,*,*"
            ColumnSpacing="6"
            RowSpacing="6">

            <views:LeftButtons Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"/>

            <ContentControl Grid.Column="1" Grid.Row="0" Content="{Binding TopDat}"/>

            <views:RVTreeView Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Nodes="{Binding Tree}"/>

            <GridSplitter Grid.Column="2" ResizeDirection="Columns" Background="Gray" Width="4" Grid.RowSpan="3" ToolTip.Tip="Drag to resize the DAT tree"/>

            <ContentControl Grid.Column="3" Grid.Row="0" Content="{Binding TopGame}"/>
       
            <ContentControl Grid.Column="3" Grid.Row="1" Content="{Binding GameGrid}"/>
     
            <ContentControl Grid.Column="3" Grid.Row="2" Content="{Binding RomGrid}"/>
     
        </Grid>





    </DockPanel>
</Window>
