<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="30"
             x:Class="AvaloniaApplication1.Views.TopMenu">
    <Menu>
        <MenuItem Header="_Update">
            <MenuItem Header="Update _All" Click="UpdateAll_Click"/>
            <MenuItem Header="_Refresh All" Click="RefreshAll_Click"/>
        </MenuItem>
        <MenuItem Header="_Scan"   Click="Scan_Click"/>
        <MenuItem Header="_Find"   Click="Find_Click"/>
    </Menu>
</UserControl>