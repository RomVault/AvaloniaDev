<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RVWorldPublic\Libraries\RVUtils\RVUtils.csproj" />
    <ProjectReference Include="..\..\RVWorldPublic\RomVaultCore\RomVaultCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\DatInfoView.axaml.cs">
      <DependentUpon>DatInfoView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\FilterView.axaml.cs">
      <DependentUpon>FilterView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\GameGridView.axaml.cs">
      <DependentUpon>GameGridView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\GameInfoView.axaml.cs">
      <DependentUpon>GameInfoView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\LeftButtonsView.axaml.cs">
      <DependentUpon>LeftButtonsView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainWindowView.axaml.cs">
      <DependentUpon>MainWindowView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\RomGridView.axaml.cs">
      <DependentUpon>RomGridView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\RVTreeView.axaml.cs">
      <DependentUpon>RVTreeView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\TopMenuView.axaml.cs">
      <DependentUpon>TopMenuView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\IconKeyView.axaml.cs">
      <DependentUpon>IconKeyView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
